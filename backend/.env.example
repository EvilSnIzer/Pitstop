# Local development defaults. Copy to .env (`cp .env.example .env`); never
# commit real secrets. Production hosting sets these through the platform —
# see deploy/RENDER_ONE_CLICK.md (all-Render, one click) or
# deploy/VERCEL_RENDER.md (split-provider variant).

APP_ENV=development
DJANGO_DEBUG=1

# Any production-like run requires a random 50+ character secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (On Render the generated 44-char secret is stretched by start-render.sh.)
# DJANGO_SECRET_KEY=

# Leave unset for SQLite development. Production requires PostgreSQL:
# DATABASE_URL=postgresql://pitstop:PASSWORD@127.0.0.1:5432/pitstop
# DB_SSLMODE=prefer
# Optional private schema (used with shared/Supabase-style Postgres):
# DATABASE_SCHEMA=pitstop

# Leave unset for process-local cache (development only). Production
# requires a shared Redis, e.g. Render Key Value or Upstash:
# REDIS_URL=redis://127.0.0.1:6379/0

# Uploaded-media backend: filesystem (default; local disk), database
# (Postgres rows — what Render free plan uses, MEDIA_STORAGE=database),
# or s3 (any S3-compatible private bucket; requires AWS_STORAGE_BUCKET_NAME).
# MEDIA_STORAGE=filesystem
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional. Empty => deterministic intake only; diagnosis reports
# ai_not_configured instead of inventing an answer. Backend-only secret:
# never expose it through the frontend or a NEXT_PUBLIC_ variable.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_USER_DAILY_CALLS=100
# AI_GLOBAL_DAILY_CALLS=2000

# Comma-separated exact origins allowed for cross-origin browser calls
# (only needed for the direct-upload flow, e.g. on Vercel; the all-Render
# stack is same-origin through the BFF and needs none).
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to 1 only on Render, where the BFF calls this API over the private
# network with a single-label internal Host header (see config/middleware.py).
# TRUST_PRIVATE_NETWORK_HOST=0
