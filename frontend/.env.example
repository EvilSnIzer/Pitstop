# Server-only upstream. Browser calls always stay at /api/v1 on this origin.
API_PROXY_URL=http://127.0.0.1:8000
APP_ENV=development

# Required in production: exact public origin (scheme + host; no trailing slash).
# APP_ORIGIN=https://pitstop.example.com
# COOKIE_SECURE=1

# Do not add JWTs, Gemini keys or backend secrets to NEXT_PUBLIC_* variables.

# Vercel: set this PUBLIC origin at build time, e.g. https://YOUR-API.onrender.com.
# Upload bytes go straight there using a short-lived upload-only ticket, not a JWT.
# Leave unset for the local/Compose same-origin upload path.
# NEXT_PUBLIC_DIRECT_API_URL=https://YOUR-API.onrender.com
