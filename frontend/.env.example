# Server-only upstream. Browser calls always stay at /api/v1 on this origin.
API_PROXY_URL=http://127.0.0.1:8000
APP_ENV=development

# Exact public origin of this app (scheme + host; no trailing slash). It must
# match the origin in the browser's address bar: the BFF rejects any mutation
# whose Origin it does not recognise with 403 csrf_failed. Use the port and
# hostname you actually browse to — if you open http://127.0.0.1:3000 instead
# of http://localhost:3000, set that value here.
APP_ORIGIN=http://localhost:3000

# On Render this can be omitted: the BFF falls back to the service's own
# injected RENDER_EXTERNAL_HOSTNAME. Set it explicitly for custom domains.
# APP_ORIGIN=https://pitstop.example.com
# COOKIE_SECURE=1

# Do not add JWTs, Gemini keys or backend secrets to NEXT_PUBLIC_* variables.

# Vercel (split-provider variant only): set this PUBLIC origin at build time,
# e.g. https://YOUR-API.onrender.com. Upload bytes go straight there using a
# short-lived upload-only ticket, not a JWT. Leave unset for the local/Compose
# and all-Render same-origin upload paths.
# NEXT_PUBLIC_DIRECT_API_URL=https://YOUR-API.onrender.com
